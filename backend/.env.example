# Copy to .env and adjust as needed.

# Optional — Settings() falls back to these same defaults if absent.
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173"]
LLM_MODEL=openai/gpt-oss-20b:free
RSS_FEED_URL=http://feeds.bbci.co.uk/news/rss.xml
RSS_SOURCE_NAME=BBC News

# Required — no safe default for a secret. Get a key at https://openrouter.ai
OPENROUTER_API_KEY=
